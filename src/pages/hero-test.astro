---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCanvas from "../components/sections/HeroCanvas.astro";
import ImageCarousel from "../components/sections/ImageCarousel.astro"; //5 images
import ExpectMore from "../components/sections/ExpectMore.astro";
import MonthEndDeals from "../components/sections/MonthEndDeals.astro";
import FinalSections from "../components/sections/FinalSections.astro";
import TholaZonkeCTA from "../components/sections/TholaZonkeCTA.astro";
import Carousel from "../components/react/Carousel"; //Banner
import { getImage, Picture, Image } from "astro:assets";
import { generateLqip } from "../utils/lqip";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import DepartmentIcons from "../components/sections/DepartmentIcons.astro";

import img1 from "../assets/images/hero-test/home_img_1.webp";
import img2 from "../assets/images/hero-test/home_img_2.webp";
import img3 from "../assets/images/hero-test/home_img_3.webp";
import img4 from "../assets/images/hero-test/home_img_4.webp";
import img5 from "../assets/images/hero-test/home_img_5.webp";
import pattern from "../assets/textures_and_borders/pattern.webp";
import banner1 from "../assets/images/home-page/home-page-carousel/home-carousel-1.webp";
import banner2 from "../assets/images/home-page/home-page-carousel/home-carousel-2.webp";
import banner3 from "../assets/images/home-page/home-page-carousel/home-carousel-3.webp";
import banner1Mobile from "../assets/images/home-page/home-page-carousel/home-carousel-1-mobile.webp";
import banner2Mobile from "../assets/images/home-page/home-page-carousel/home-carousel-2-mobile.webp";
import banner3Mobile from "../assets/images/home-page/home-page-carousel/home-carousel-3-mobile.webp";

// 5 image carousel
const carouselImages = [
  { src: img1, alt: "OBC Store Environment 1" },
  { src: img2, alt: "OBC Store Environment 2" },
  { src: img3, alt: "OBC Store Environment 3" },
  { src: img4, alt: "OBC Store Environment 4" },
  { src: img5, alt: "OBC Store Environment 5" },
];

//banner carousel
const [b1, b2, b3, bm1, bm2, bm3] = await Promise.all([
  getImage({ src: banner1, format: "webp" }),
  getImage({ src: banner2, format: "webp" }),
  getImage({ src: banner3, format: "webp" }),
  getImage({ src: banner1Mobile, format: "webp" }),
  getImage({ src: banner2Mobile, format: "webp" }),
  getImage({ src: banner3Mobile, format: "webp" }),
]);

const lqipDesktop = await generateLqip(
  await readFile(
    join(
      process.cwd(),
      "src/assets/images/home-page/home-page-carousel/home-carousel-1.webp",
    ),
  ),
);

const lqipMobile = await generateLqip(
  await readFile(
    join(
      process.cwd(),
      "src/assets/images/home-page/home-page-carousel/home-carousel-1-mobile.webp",
    ),
  ),
);

const bannerCarouselImages = [
  {
    src: b1.src,
    lqip: lqipDesktop,
    mobileSrc: bm1.src,
    mobileLqip: lqipMobile,
    alt: "Banner Image",
  },
  {
    src: b2.src,
    lqip: lqipDesktop,
    mobileSrc: bm2.src,
    mobileLqip: lqipMobile,
    alt: "Banner Image",
  },
  {
    src: b3.src,
    lqip: lqipDesktop,
    mobileSrc: bm3.src,
    mobileLqip: lqipMobile,
    alt: "Banner Image",
  },
];
---

<BaseLayout title="Hero Test">
  <!-- Our new experimental component -->
  <!-- We have moved the text highlighting animation directly into the hero curtain to remove the dead space! -->
  <HeroCanvas />

  <!-- Our new seamless image carousel -->
  <!-- We use a negative margin here to pull the carousel natively up over the empty bottom-half of the hero curtain! -->
  <!-- This completely fixes the layout without breaking the document's scroll height! -->
  <div class="relative z-40 -mt-[35vh] bg-[#181818]">
    <ImageCarousel images={carouselImages} />

    <!-- The new Expect More overlapping images section -->
    <ExpectMore />

    <!-- The new Month End Deals buttons section -->
    <MonthEndDeals />

    <div class="w-full overflow-hidden leading-none">
      <Image
        src={pattern}
        alt=""
        aria-hidden="true"
        class="w-full h-auto block"
        loading="eager"
      />
    </div>
    <div class="sticky top-0 w-full z-0">
      <Carousel client:load images={bannerCarouselImages} />
    </div>
    <div class="relative z-20 bg-brand-bg min-h-screen pt-[10vh] md:pt-[10vh]">
      <p
        class="body-text-large max-w-6xl mx-auto px-8 tracking-tight md:leading-14"
      >
        We are bringing{" "}
        <span class="font-bold">quality, affordability & convenience</span><br
        />to you, Mzansi.<br /><span class="small-heading text-center"
          >#<span class="font-normal">THE</span>OBVIYASBETTER<span
            class="font-normal">CHOICE</span
          ></span
        >
      </p>
      <DepartmentIcons />
      <!-- The final Store Finder and Blockman's Den sections -->
      <FinalSections />
    </div>
  </div>

  <!-- Thola Zonke Rewards CTA - Pinned so the footer scrolls over it -->
  <div id="thola-cta-pin" class="w-full z-0 relative">
    <TholaZonkeCTA />
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let ctaPinTrigger;

  function initCtaPin() {
    if (!document.getElementById("thola-cta-pin")) return;

    if (ctaPinTrigger) {
      ctaPinTrigger.kill();
    }

    ctaPinTrigger = ScrollTrigger.create({
      trigger: "#thola-cta-pin",
      start: "top top",
      end: () => `+=${document.querySelector("footer")?.offsetHeight || 500}`,
      pin: true,
      pinSpacing: false,
    });
  }

  document.addEventListener("astro:page-load", initCtaPin);

  document.addEventListener("astro:before-swap", () => {
    if (ctaPinTrigger) {
      ctaPinTrigger.kill();
      ctaPinTrigger = null;
    }
  });
</script>
