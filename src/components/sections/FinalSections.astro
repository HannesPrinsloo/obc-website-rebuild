---
import { Image } from "astro:assets";
import storeFinderImg from "../../assets/images/hero-test/store_finder_img.webp";
import blockmansDenImg from "../../assets/images/hero-test/blockmans_den_img.webp";
---

<section
  class="w-full max-w-[1308px] mx-auto px-6 md:px-8 pb-24 flex flex-col gap-6 md:gap-8"
>
  <!-- Store Finder Section -->
  <div
    class="final-block relative rounded-2xl md:rounded-[20px] bg-brand-primary flex flex-col md:flex-row items-center p-6 md:p-10 lg:p-12 gap-8 md:gap-12 overflow-hidden origin-top md:origin-left"
  >
    <!-- Text Content -->
    <div
      class="final-content opacity-0 translate-y-8 flex-1 flex flex-col justify-center items-center text-center text-white order-2 md:order-1 px-2 md:px-4 z-10 gap-2 md:gap-3"
    >
      <h3
        class="text-lg lg:text-2xl font-black tracking-widest uppercase leading-none"
      >
        FIND AN OBC NEAR YOU
      </h3>
      <p class="text-xl md:text-2xl lg:text-3xl font-light leading-tight">
        <span class="font-bold">We are growing, fast.</span> We're opening stores<br
          class="hidden lg:block"
        />
        every month - if you don't already have an OBC<br
          class="hidden lg:block"
        />
        near you, trust us we'll be there very soon.
      </p>

      <a
        href="/store-finder"
        class="small-heading scale-100 md:scale-70 relative inline-block group transition-opacity duration-300 ease-out text-brand-light mt-1"
      >
        <span
          class="inline-block transition-transform duration-300 ease-out group-hover:-skew-x-12 uppercase"
        >
          STORE FINDER
        </span>
        <span
          class="absolute right-0 -bottom-1 w-full h-[2px] bg-current transition-all duration-300 ease-out group-hover:w-0"
        ></span>
      </a>
    </div>

    <!-- Image Content -->
    <div
      class="final-content opacity-0 translate-y-8 parallax-container w-full max-w-[386px] shrink-0 aspect-[386/343] rounded-2xl overflow-hidden order-1 md:order-2 relative mx-auto md:mx-0 z-10"
    >
      <Image
        src={storeFinderImg}
        alt="OBC Butchery Store Front"
        class="parallax-image absolute inset-0 w-full h-full object-cover"
      />
    </div>
  </div>

  <!-- Blockman's Den Section -->
  <div
    class="final-block relative rounded-2xl md:rounded-[20px] bg-[#181818] flex flex-col md:flex-row items-center p-6 md:p-10 lg:p-12 gap-8 md:gap-12 overflow-hidden origin-top md:origin-left"
  >
    <!-- Image Content -->
    <div
      class="final-content opacity-0 translate-y-8 parallax-container w-full max-w-[386px] shrink-0 aspect-[386/343] rounded-2xl overflow-hidden order-1 relative mx-auto md:mx-0 z-10"
    >
      <Image
        src={blockmansDenImg}
        alt="Blockman's Den"
        class="parallax-image absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <!-- Text Content -->
    <div
      class="final-content opacity-0 translate-y-8 flex-1 flex flex-col justify-center items-center text-center text-white order-2 px-2 md:px-4 z-10 gap-2 md:gap-3"
    >
      <h3
        class="text-lg lg:text-2xl font-black tracking-widest uppercase leading-none"
      >
        LEARN FROM OUR BLOCKMAN
      </h3>
      <p class="text-xl md:text-2xl lg:text-3xl font-light leading-tight">
        Welcome to Blockman's Den, your go-to spot for<br
          class="hidden lg:block"
        />
        mastering meat cuts. Our page breaks it down simply,<br
          class="hidden lg:block"
        />
        from juicy steaks to tender roasts, let's learn with our<br
          class="hidden lg:block"
        />
        master Blockman about the different cuts of meat!
      </p>

      <a
        href="/blockmans-den"
        class="small-heading scale-100 md:scale-70 relative inline-block group transition-opacity duration-300 ease-out text-brand-light mt-1"
      >
        <span
          class="inline-block transition-transform duration-300 ease-out group-hover:-skew-x-12 uppercase"
        >
          BLOCKMAN'S DEN
        </span>
        <span
          class="absolute right-0 -bottom-1 w-full h-[2px] bg-current transition-all duration-300 ease-out group-hover:w-0"
        ></span>
      </a>
    </div>
  </div>
</section>



<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    const blocks = document.querySelectorAll<HTMLElement>(".final-block");
    const isDesktop = window.innerWidth >= 768;

    blocks.forEach((block) => {
      const contents = block.querySelectorAll<HTMLElement>(".final-content");

      gsap.set(block, {
        scaleX: isDesktop ? 0 : 1,
        scaleY: isDesktop ? 1 : 0
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: block,
          start: "top 75%",
        }
      });

      tl.to(block, {
        scaleX: 1,
        scaleY: 1,
        duration: 1.2,
        ease: "expo.out"
      });

      tl.to(contents, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "back.out(1.5)"
      }, "-=0.8");
    });

    const containers = document.querySelectorAll<HTMLElement>(".parallax-container");

    containers.forEach((container) => {
      const img = container.querySelector<HTMLElement>(".parallax-image");
      if (!img) return;

      gsap.fromTo(
        img,
        { scale: 1.2 },
        {
          scale: 1,
          ease: "none",
          scrollTrigger: {
            trigger: container,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        },
      );
    });
  });
</script>
