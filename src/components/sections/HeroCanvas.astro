---
// src/components/sections/HeroCanvas.astro
---

<div class="hero-wrapper relative w-full h-[400vh]">
  <div class="sticky top-0 w-full h-screen overflow-hidden bg-brand-dark">
    <canvas
      id="video-canvas"
      class="absolute inset-0 w-full h-full object-cover z-0"></canvas>

    <div
      id="hero-text"
      class="absolute inset-0 z-20 flex flex-col items-center justify-center pointer-events-none"
    >
      <div
        id="hero-squish"
        class="flex flex-col items-center gap-[8vh] opacity-0"
      >
        <h1
          id="hero-heading-squish"
          class="flex flex-col items-center text-center font-sans uppercase leading-[0.85] gap-[1vh] md:gap-[2vh]"
        >
          <span class="block text-brand-primary font-medium text-[clamp(2.8rem,5.2vw,7rem)] [text-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)]">
            JOIN THE
          </span>
          <span class="block text-white font-black text-[clamp(4.9rem,9vw,12rem)] [text-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)] -mt-[2%]">
            BRAAI
          </span>
          <span class="block text-white font-black text-[clamp(4.9rem,9vw,12rem)] [text-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)] -mt-[2%] pl-[0.15em]">
            NATION<span class="text-brand-primary">.</span>
          </span>
        </h1>

        <a
          id="hero-promotions-btn"
          href="#promotions"
          class="btn-outline card-btn inline-flex before:bg-[#181818] items-center justify-center bg-brand-primary text-brand-light font-bold px-6 py-2 md:px-5 md:py-3 rounded-full hover:bg-brand-primary border-brand-primary transition-colors uppercase tracking-[0.2em] pointer-events-auto text-[clamp(0.75rem,0.9vw,0.95rem)] [box-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)]"
        >
          VIEW OUR PROMOTIONS
        </a>
      </div>
    </div>

    <div
      id="next-section"
      class="absolute top-full left-0 w-full h-screen bg-brand-dark z-30 flex flex-col items-center justify-center"
    >
      <svg
        class="absolute bottom-[calc(100%-2px)] left-0 w-full h-[25vh] md:h-[50vh] pointer-events-none"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <path
          id="arc-path"
          fill="#181818"
          d="M 0 100 L 0 100 Q 50 100 100 100 L 100 100 Z"></path>
      </svg>

      <div
        class="w-full max-w-6xl mx-auto px-6 md:px-8 flex flex-col items-center justify-center mt-[-10vh]"
      >
        <h3 class="small-heading text-center mb-8 md:mb-12 text-brand-light">
          QUALITY &amp; AFFORDABILITY SINCE 1984
        </h3>
        <p
          id="hero-highlight-text"
          class="body-text-large text-brand-light text-center"
        >
          Experience the difference with OBC - the home of quality,
          affordability, and Kasi convenience. We’re more than just a butchery.
        </p>
      </div>
    </div>
  </div>
</div>

