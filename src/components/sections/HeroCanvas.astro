<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger, SplitText);

    const canvas = document.getElementById("video-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");

    // Lock scrolling while loading (DISABLED FOR NOW)
    // document.body.style.overflow = "hidden";

    const isMobile = window.innerWidth < 768;
    const isHighDPI = window.devicePixelRatio > 1.2;
    // Serve 4K to ultra-wide screens OR large screens with High-DPI (e.g., MacBooks)
    const is4K =
      window.innerWidth >= 2560 || (window.innerWidth >= 1024 && isHighDPI);

    let basePath = "/hero/1080p/";
    if (isMobile) basePath = "/hero/mobile/";
    else if (is4K) basePath = "/hero/4k/";

    const frameCount = 145;
    const currentFrame = (index: number) =>
      `${basePath}frame_${(index + 1).toString().padStart(3, "0")}.webp`;

    if (isMobile) {
      canvas.width = 720;
      canvas.height = 1280;
    } else if (is4K) {
      canvas.width = 3840;
      canvas.height = 2160;
    } else {
      canvas.width = 1728;
      canvas.height = 1116;
    }

    const connection = (navigator as any).connection;
    const isSlowNetwork =
      connection &&
      (connection.saveData ||
        ["slow-2g", "2g", "3g"].includes(connection.effectiveType));

    if (isSlowNetwork) {
      console.log("Slow network detected. Static hero loaded.");
    }

    let loadedCount = 0;
    const framesRequiredToStart = isSlowNetwork ? 1 : Math.min(30, frameCount);

    const updateProgress = () => {
      loadedCount++;
      const progress = (loadedCount / framesRequiredToStart) * 100;
      const progressContainer = document.getElementById(
        "hero-loader-progress-container",
      );

      if (progressContainer && loadedCount <= framesRequiredToStart) {
        progressContainer.style.height = `${progress}%`;
      }

      if (loadedCount === framesRequiredToStart) {
        const loader = document.getElementById("hero-loader");
        if (loader) {
          loader.style.opacity = "0";
          setTimeout(() => {
            loader.style.display = "none";
            document.body.style.overflow = "";
          }, 700);
        }
      }
    };

    const firstImage = new Image();
    firstImage.onload = () => {
      ctx?.drawImage(firstImage, 0, 0, canvas.width, canvas.height);
      updateProgress();
    };
    firstImage.onerror = updateProgress;
    firstImage.src = currentFrame(0);

    const images: HTMLImageElement[] = [firstImage];
    if (!isSlowNetwork) {
      for (let i = 1; i < frameCount; i++) {
        const img = new Image();
        img.onload = updateProgress;
        img.onerror = updateProgress; // Prevent loader from getting stuck
        img.src = currentFrame(i);
        images.push(img);
      }
    }

    // Wait for fonts to load before calculating text splits and building timeline
    document.fonts.ready.then(() => {
      // TEXT HIGHLIGHT SETUP
      const highlightText = document.querySelector("#hero-highlight-text");
      const masks: HTMLElement[] = [];

      if (highlightText) {
        if ((highlightText as any)._split)
          (highlightText as any)._split.revert();
        const splitHighlight = new SplitText(highlightText, { type: "lines" });
        (highlightText as any)._split = splitHighlight;

        splitHighlight.lines.forEach((lineElement) => {
          const line = lineElement as HTMLElement;
          line.style.position = "relative";
          const mask = document.createElement("span");
          mask.className =
            "absolute top-0 left-0 w-full h-[115%] bg-[#181818] opacity-[0.85] z-10 origin-left scale-x-0 pointer-events-none";
          line.appendChild(mask);
          masks.push(mask);
        });
      }

      // ARC MASK STATE
      const arcPath = document.getElementById("arc-path");
      const arcState = { side: 100, mid: 100 };

      const updatePath = () => {
        if (arcPath) {
          arcPath.setAttribute(
            "d",
            `M 0 100 L 0 ${arcState.side} Q 50 ${arcState.mid} 100 ${arcState.side} L 100 100 Z`,
          );
        }
      };

      // ENTRANCE ANIMATION (Matches thola-zonke.astro)
      const heroHeading = document.querySelector("#hero-heading-squish");
      if (heroHeading) {
        if ((heroHeading as any)._splitEntrance)
          (heroHeading as any)._splitEntrance.revert();
        const splitEntrance = new SplitText(heroHeading, {
          type: "lines",
          mask: "lines",
          linesClass: "box-content py-[0.3em] -my-[0.3em]",
          autoSplit: true,
          onSplit: (self) => {
            gsap.set("#hero-squish", { opacity: 1 });
            
            gsap.from(self.lines, {
              yPercent: 120,
              duration: 1.2,
              ease: "expo.out",
              stagger: 0.05,
              delay: 0.8,
            });
          },
        });
        (heroHeading as any)._splitEntrance = splitEntrance;
      }

      gsap.from("#hero-promotions-btn", {
        opacity: 0,
        y: 20,
        duration: 1,
        ease: "power3.out",
        delay: 0.6,
      });

      // GSAP TIMELINE
      const imageInfo = { frame: 0 };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".hero-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 2.5,
          onLeave: () => {
            canvas.style.display = "none";
          },
          onEnterBack: () => {
            canvas.style.display = "block";
          },
        },
      });

      tl.to(
        imageInfo,
        {
          frame: frameCount - 1,
          snap: "frame",
          ease: "none",
          duration: 6,
          onUpdate: () => {
            if (isSlowNetwork) return;
            const img = images[imageInfo.frame];
            if (img && img.complete) {
              ctx?.clearRect(0, 0, canvas.width, canvas.height);
              ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);
            }
          },
        },
        0,
      );

      tl.to(
        arcState,
        {
          side: 0,
          mid: 100,
          ease: "power2.in",
          duration: 1.5,
          onUpdate: updatePath,
        },
        4,
      );

      tl.to(
        "#hero-text",
        {
          y: "15vh",
          ease: "none",
          duration: 8.0,
        },
        0,
      );

      tl.to(
        "#hero-squish",
        {
          gap: "0vh",
          ease: "none",
          duration: 8.0,
        },
        0,
      );

      tl.to(
        "#hero-heading-squish",
        {
          gap: "0vh",
          ease: "none",
          duration: 8.0,
        },
        0,
      );

      tl.to(
        arcState,
        {
          side: 100,
          mid: 0,
          ease: "power2.out",
          duration: 2.5,
          onUpdate: updatePath,
        },
        5.5,
      );

      tl.to(
        "#next-section",
        {
          yPercent: -100,
          ease: "power2.out",
          duration: 2.5,
        },
        5.5,
      );

      if (masks.length > 0) {
        tl.to(
          masks,
          {
            scaleX: 1,
            ease: "none",
            duration: 0.5,
            stagger: 0.5,
          },
          6.7,
        );
      }
    });
  });
</script>
