---
// src/components/sections/HeroCanvas.astro
---

<div class="hero-wrapper relative w-full h-[400vh]">
  <!-- 
    The sticky container stays pinned to the screen for the duration of the scroll.
  -->
  <div class="sticky top-0 w-full h-screen overflow-hidden bg-brand-dark">
    <!-- The Canvas where we draw the frames -->
    <canvas
      id="video-canvas"
      class="absolute inset-0 w-full h-full object-cover z-0"></canvas>

    <!-- The Text Overlay -->
    <div
      id="hero-text"
      class="absolute inset-0 z-20 flex flex-col items-center justify-center pointer-events-none"
    >
      <!-- The Dynamically Shrinking Container -->
      <div id="hero-squish" class="flex flex-col items-center gap-[8vh]">
        <h1
          id="hero-heading-squish"
          class="flex flex-col items-center text-brand-primary text-center font-black uppercase text-[clamp(4rem,8cqw,10rem)] leading-[0.8] [text-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)] gap-[4vh]"
        >
          <span>Join the</span>
          <span>
            <span class="text-white">Braai Nation</span><span class="text-brand-primary">.</span>
          </span>
        </h1>
        
        <a
          id="hero-promotions-btn"
          href="#promotions"
          class="btn-outline card-btn inline-flex before:bg-[#181818] items-center justify-center bg-brand-primary text-brand-light font-bold px-8 py-3 md:px-10 md:py-4 rounded-full hover:bg-brand-primary border-brand-primary transition-colors uppercase tracking-[0.2em] pointer-events-auto text-[clamp(0.75rem,0.9vw,0.95rem)] [box-shadow:5px_3px_3.4px_rgba(0,0,0,0.9)]"
        >
          VIEW OUR PROMOTIONS
        </a>
      </div>
    </div>

    <!-- The Next Section (Starts positioned exactly below the viewport) -->
    <div
      id="next-section"
      class="absolute top-full left-0 w-full h-screen bg-brand-dark z-30 flex flex-col items-center justify-center"
    >
      <!-- SVG Mask is now the literal leading edge of the next section -->
      <!-- Added bottom-[calc(100%-2px)] to overlap by 2px and eliminate the sub-pixel gap -->
      <svg
        class="absolute bottom-[calc(100%-2px)] left-0 w-full h-[25vh] md:h-[50vh] pointer-events-none"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <path
          id="arc-path"
          fill="#181818"
          d="M 0 100 L 0 100 Q 50 100 100 100 L 100 100 Z"></path>
      </svg>

      <!-- We put the text physically ON the curtain, perfectly centered. Zero dead space. -->
      <div
        class="w-full max-w-6xl mx-auto px-6 md:px-8 flex flex-col items-center justify-center mt-[-10vh]"
      >
        <h3 class="small-heading text-center mb-8 md:mb-12 text-brand-light">
          QUALITY &amp; AFFORDABILITY SINCE 1984
        </h3>
        <p
          id="hero-highlight-text"
          class="body-text-large text-brand-light text-center"
        >
          Experience the difference with OBC - the home of quality,
          affordability, and Kasi convenience. We’re more than just a butchery.
          Our stores are stocked with everything from fresh produce to
          groceries.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger, SplitText);

    const canvas = document.getElementById("video-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");

    const isMobile = window.innerWidth < 768;
    const is4K = window.innerWidth >= 2560;

    let basePath = "/hero/1080p/";
    if (isMobile) basePath = "/hero/mobile/";
    else if (is4K) basePath = "/hero/4k/";

    const frameCount = 145;
    const currentFrame = (index: number) =>
      `${basePath}frame_${(index + 1).toString().padStart(3, "0")}.webp`;

    if (isMobile) {
      canvas.width = 720;
      canvas.height = 1280;
    } else if (is4K) {
      canvas.width = 3840;
      canvas.height = 2160;
    } else {
      canvas.width = 1728;
      canvas.height = 1116;
    }

    const firstImage = new Image();
    firstImage.src = currentFrame(0);
    firstImage.onload = () => {
      ctx?.drawImage(firstImage, 0, 0, canvas.width, canvas.height);
    };

    const connection = (navigator as any).connection;
    const isSlowNetwork =
      connection &&
      (connection.saveData ||
        ["slow-2g", "2g", "3g"].includes(connection.effectiveType));

    if (isSlowNetwork) {
      console.log("Slow network detected. Static hero loaded.");
    }

    const images: HTMLImageElement[] = [firstImage];
    if (!isSlowNetwork) {
      for (let i = 1; i < frameCount; i++) {
        const img = new Image();
        img.src = currentFrame(i);
        images.push(img);
      }
    }

    // Wait for fonts to load before calculating text splits and building timeline
    document.fonts.ready.then(() => {
      // TEXT HIGHLIGHT SETUP
      const highlightText = document.querySelector("#hero-highlight-text");
      const masks: HTMLElement[] = [];

      if (highlightText) {
        if ((highlightText as any)._split)
          (highlightText as any)._split.revert();
        const splitHighlight = new SplitText(highlightText, { type: "lines" });
        (highlightText as any)._split = splitHighlight;

        splitHighlight.lines.forEach((lineElement) => {
          const line = lineElement as HTMLElement;
          line.style.position = "relative";
          const mask = document.createElement("span");
          mask.className =
            "absolute top-0 left-0 w-full h-[115%] bg-[#181818] opacity-[0.85] z-10 origin-left scale-x-0 pointer-events-none";
          line.appendChild(mask);
          masks.push(mask);
        });
      }

      // ARC MASK STATE
      const arcPath = document.getElementById("arc-path");
      const arcState = { side: 100, mid: 100 };

      const updatePath = () => {
        if (arcPath) {
          arcPath.setAttribute(
            "d",
            `M 0 100 L 0 ${arcState.side} Q 50 ${arcState.mid} 100 ${arcState.side} L 100 100 Z`,
          );
        }
      };

      // GSAP TIMELINE
      const imageInfo = { frame: 0 };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".hero-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 1.5,
          onLeave: () => {
            canvas.style.display = "none";
          },
          onEnterBack: () => {
            canvas.style.display = "block";
          },
        },
      });

      // 1. Scrub the Video (Timeline 0 to 6)
      tl.to(
        imageInfo,
        {
          frame: frameCount - 1,
          snap: "frame",
          ease: "none",
          duration: 6,
          onUpdate: () => {
            if (isSlowNetwork) return;
            const img = images[imageInfo.frame];
            if (img && img.complete) {
              ctx?.clearRect(0, 0, canvas.width, canvas.height);
              ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);
            }
          },
        },
        0,
      );

      // 2. Start the Convex Arc (Mask dips in the middle, pushing video down)
      tl.to(
        arcState,
        {
          side: 0,
          mid: 100,
          ease: "power2.inOut",
          duration: 1.5,
          onUpdate: updatePath,
        },
        4,
      );

      // 3. Subtle Parallax and Line Spacing Squeeze on the Text
      // This spans the entire duration of the scrub + curtain slide (8.5 total)
      tl.to(
        "#hero-text",
        {
          y: "15vh", // Subtly move down the screen
          ease: "none",
          duration: 8.5,
        },
        0
      );

      // Shrink the gap between the button and the heading container
      tl.to(
        "#hero-squish",
        {
          gap: "0vh", 
          ease: "none",
          duration: 8.5,
        },
        0
      );

      // Shrink the gap between the two text lines themselves
      tl.to(
        "#hero-heading-squish",
        {
          gap: "0vh", 
          ease: "none",
          duration: 8.5,
        },
        0
      );

      // 4. Sweep from Convex to Concave using your bezier
      tl.to(
        arcState,
        {
          side: 100,
          mid: 0,
          ease: "cubic-bezier(0.59, 0.22, 0.73, 0.67)",
          duration: 2.5,
          onUpdate: updatePath,
        },
        5.5,
      );

      // 5. Slide the Next Section up
      tl.to(
        "#next-section",
        {
          yPercent: -100,
          ease: "cubic-bezier(0.59, 0.22, 0.73, 0.67)",
          duration: 2.5,
        },
        6.0,
      );

      // 6. Highlight text!
      // Setting stagger equal to duration ensures they run perfectly sequentially (one at a time)
      if (masks.length > 0) {
        tl.to(
          masks,
          {
            scaleX: 1,
            ease: "none",
            duration: 0.5,
            stagger: 0.5,
          },
          7.2,
        );
      }
    });
  });
</script>
