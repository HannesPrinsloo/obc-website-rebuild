---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  class?: string;
}

const { images, class: className } = Astro.props;

const processedImages = await Promise.all(
  images.map(async (img) => ({
    ...img,
    optimisedImage: await getImage({ src: img.src, format: "webp" }),
  })),
);
---

<section class:list={["image-carousel-section w-full pb-12 md:pb-24 bg-[#181818]", className]}>
  <div class="image-carousel-grid">
    {
      processedImages.map((img) => (
        <div class="carousel-card">
          <img
            src={img.optimisedImage.src}
            alt={img.alt}
            class="carousel-image"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </div>

  <!-- Mobile Carousel Tracker Dots -->
  <div class="carousel-dots flex md:hidden items-center justify-center gap-3 mt-6 w-full px-4">
    {
      processedImages.map((_, index) => (
        <button
          class={`carousel-dot h-2 rounded-full transition-all duration-300 pointer-events-auto ${index === 0 ? "bg-brand-primary w-4" : "bg-gray-300 w-2"}`}
          aria-label={`Go to slide ${index + 1}`}
        />
      ))
    }
  </div>

  <!-- Bottom Text & Link Section -->
  <div class="max-w-[1308px] mx-auto px-6 md:px-8 mt-16 md:mt-24 flex flex-col items-center">
    <p
      id="bottom-highlight-text"
      class="body-text-large text-brand-light text-center max-w-4xl mx-auto"
    >
      <span class="font-bold">We ensure your budget goes further without compromising on that A-grade taste.</span> Whether you’re fueling the hustle or feeding the whole family, we’ve got you covered under one roof with the freshest deals in town.
    </p>
    
    <div class="text-center mt-12 mb-8">
      <a
        href="/about-us"
        class="small-heading scale-70 relative inline-block group transition-opacity duration-300 ease-out text-brand-light"
      >
        <span class="inline-block transition-transform duration-300 ease-out group-hover:-skew-x-12 uppercase">
          ABOUT US
        </span>
        <span
          class="absolute right-0 -bottom-1 w-full h-[2px] bg-current transition-all duration-300 ease-out group-hover:w-0"
        ></span>
      </a>
    </div>
  </div>
</section>

<style>
  .image-carousel-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    width: 100%;
    max-width: 1308px; /* Match exact Figma width */
    margin-inline: auto;
    gap: 1rem;
    padding: 0 1rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .image-carousel-grid::-webkit-scrollbar {
    display: none;
  }

  @media (width >= 768px) {
    .image-carousel-grid {
      display: grid;
      overflow-x: hidden;
      grid-template-columns: repeat(5, 1fr);
      gap: 17px; /* Exact gap from Figma */
      padding: 0; /* Flush with the 1308px container edge */
    }
  }

  .carousel-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 85vw;
    scroll-snap-align: start;
    border-radius: 0; /* Remove rounded corners to match Figma */
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  @media (width >= 768px) {
    .carousel-card {
      flex: none;
      width: auto;
      height: 339px; /* Exact height from Figma */
      aspect-ratio: auto;
    }
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.5);
    transform-origin: center center;
    will-change: transform;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger, SplitText);

    // Initialize Zoom-out Parallax Animation for Images
    const cards = document.querySelectorAll<HTMLElement>(".carousel-card");
    cards.forEach((card) => {
      const img = card.querySelector<HTMLElement>(".carousel-image");
      if (!img) return;

      gsap.fromTo(
        img,
        { scale: 1.5 },
        {
          scale: 1.0,
          ease: "none",
          scrollTrigger: {
            trigger: card,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        },
      );
    });

    // Initialize Mobile Tracker Dots
    const grids = document.querySelectorAll(".image-carousel-grid");
    grids.forEach((grid) => {
      const section = grid.closest(".image-carousel-section");
      if (!section) return;
      
      const carouselCards = grid.querySelectorAll(".carousel-card");
      const dots = section.querySelectorAll(".carousel-dot");

      if (carouselCards.length > 0 && dots.length > 0) {
        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            const card = carouselCards[index] as HTMLElement;
            if (card) {
              grid.scrollTo({
                left: card.offsetLeft - grid.clientLeft,
                behavior: "smooth",
              });
            }
          });
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const index = Array.from(carouselCards).indexOf(entry.target);
                if (index !== -1 && dots[index]) {
                  dots.forEach((d) => {
                    d.classList.remove("bg-brand-primary", "w-4");
                    d.classList.add("bg-gray-300", "w-2");
                  });
                  dots[index].classList.remove("bg-gray-300", "w-2");
                  dots[index].classList.add("bg-brand-primary", "w-4");
                }
              }
            });
          },
          { root: grid, threshold: 0.6 },
        );

        carouselCards.forEach((card) => observer.observe(card));
        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
    });

    // Initialize SplitText Highlight Animation for Bottom Text
    document.fonts.ready.then(() => {
      const highlightText = document.querySelector("#bottom-highlight-text");
      const masks: HTMLElement[] = [];

      if (highlightText) {
        const splitHighlight = new SplitText(highlightText, { type: "lines" });
        splitHighlight.lines.forEach((lineElement) => {
          const line = lineElement as HTMLElement;
          line.style.position = "relative";
          const mask = document.createElement("span");
          mask.className =
            "absolute top-0 left-0 w-full h-[115%] bg-[#181818] opacity-[0.85] z-10 origin-left scale-x-0 pointer-events-none";
          line.appendChild(mask);
          masks.push(mask);
        });

        gsap.to(masks, {
          scaleX: 1,
          ease: "none",
          duration: 1,
          stagger: 1,
          scrollTrigger: {
            trigger: highlightText,
            start: "top 80%",
            end: "bottom 50%",
            scrub: true,
          },
        });
      }
    });
  });
</script>
