---
// TholaZonkeCTA.astro
---

<section class="w-full bg-brand-bg py-20 md:py-32 px-4 md:px-6">
  <div class="max-w-[1308px] mx-auto flex flex-col items-center text-center">
    <h3 class="small-heading text-center text-brand-dark mb-6 md:mb-10">
      THOLA ZONKE REWARDS
    </h3>
    
    <h2 class="body-text-large font-bold text-brand-dark mb-6 tracking-tight md:leading-14 text-balance">
      Expect great benefits when joining the Thola Zonke Rewards Club
    </h2>
    
    <p class="text-[1rem] md:text-xl text-brand-dark max-w-4xl mx-auto mb-10 md:mb-14 font-light">
      Log in or install the app to track and view your savings
    </p>

    <div class="flex flex-col lg:flex-row items-center justify-center gap-4 w-full">
      <a
          href="https://tholazonke.co.za/#!/obcLogin"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline flex items-center justify-center text-center w-full max-w-[220px] lg:w-auto bg-brand-primary before:bg-brand-light text-brand-light font-bold text-xs md:text-sm px-8 py-3 rounded-full border-brand-primary uppercase tracking-widest hover:opacity-90 transition-opacity"
      >
          LOG IN
      </a>
      <a
          href="https://tholazonke.co.za/#!/obcLogin"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline btn-install-app flex items-center justify-center text-center w-full max-w-[220px] lg:w-auto bg-brand-light before:bg-brand-primary text-brand-dark font-bold text-xs md:text-sm px-8 py-3 rounded-full border-brand-dark uppercase tracking-widest transition-opacity mb-12 md:mb-0"
      >
          INSTALL APP
      </a>
    </div>
  </div>
</section>
